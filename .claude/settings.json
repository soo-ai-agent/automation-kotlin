{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-bulk-api-calls.sh\"",
            "timeout": 10,
            "statusMessage": "외부 API 대량 호출 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-speckit-preset-stale.sh\"",
            "timeout": 10,
            "statusMessage": "한국어 프리셋 동기화 확인"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/bin/layer-check\" --hook",
            "timeout": 15,
            "statusMessage": "계층 규칙 검사"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/bin/style-check\" --hook",
            "timeout": 600,
            "statusMessage": "스타일·타입 검사"
          }
        ]
      }
    ]
  }
}
