# gradle / kotlin (backend)
backend/.gradle/
backend/build/
backend/*/build/
backend/*/*/build/
!backend/gradle/wrapper/gradle-wrapper.jar
out/

# node (frontend)
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# ide
.idea/
*.iml
.vscode/
.DS_Store

# env
.env
frontend/.env
*.local.yml

# 에이전트가 만들고 지우는 임시 파일 — 커밋되면 안 된다
.claude-spec.md
.claude-split/

# spec-kit 설치물 — .github/agent/setup-speckit.sh 가 깐다. 다시 돌리면 다시 생긴다.
# 한국어 번역 원본은 common/speckit-ko/ 에 있고 그쪽은 커밋한다.
# 산출물(specs/)은 프로젝트 내용이므로 무시하지 않는다.
# speckit-* 스킬 10종이 우리 스킬과 같은 폴더에 깔리므로 이름으로 갈라 무시한다.
#
# 예외는 constitution 하나다 — 설치물이 아니라 우리가 쓴 규칙 문서라서 공유해야 한다.
# 부모 폴더를 통째로 무시하면 안쪽 파일을 되살릴 수 없어, 한 단계씩 열어 준다.
.specify/*
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md
.claude/skills/speckit-*/

# 노드 역할의 원본은 .github/agent/nodes/ 다. launcher 가 여기로 복사해 로컬 세션과
# 워크플로가 `--agent`·`agentType` 으로 쓸 수 있게 한다. 커밋하면 작업 브랜치가
# 자기 역할을 고칠 수 있게 되므로 무시한다 (common/docs/automation-spec.md 4절).
.claude/agents/

# expo (frontend)
frontend/.expo/
